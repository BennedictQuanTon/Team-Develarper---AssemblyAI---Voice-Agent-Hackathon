# Environments & Secrets (CRITICAL: Never commit real keys)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Node / Frontend Dependencies & Build Output
node_modules/
**/node_modules/
dist/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# Python Virtual Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.venv/
venv/
.run/

# Local Data & Vector/Keyword Indexes
data/chroma/
data/bm25/
*.bin
*.pkl

# Reports, Audio Artifacts & Logs
reports/*.jsonl
reports/*.html
reports/audio/
!reports/.gitkeep
logs/
*.log

# IDE, OS & Editor Artifacts
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Model Caches (Local HuggingFace / Sentence Transformers)
.cache/
sentence-transformers/

# SQLite Runtime Artifacts
:memory:.ses
*.ses
