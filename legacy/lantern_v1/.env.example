# Archived Lantern V1 configuration. Copy to the repository root as `.env`
# only when reproducing the legacy runtime; never commit real credentials.

# Vendor providers
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=
CARTESIA_API_KEY=

# Waiter model: local Ollama experiment with Gemini fallback
AGENT_MODE=waiter
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=256
OLLAMA_TEMPERATURE=0.3
OLLAMA_REASONING=
OLLAMA_WARMUP=true
WAITER_TEMPLATE_REPLIES=false

# Optional Gemini limiter
# GEMINI_RPM=15
# GEMINI_BURST=6

# Voice configuration
CARTESIA_VOICE_ID=
VOICE_PROFILE=friendly_guide
GEMINI_MODEL=gemini-3.5-flash-lite
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
ASSEMBLYAI_MODE=min_latency

# Archived data paths
CHROMA_PERSIST_DIR=legacy/travel/runtime/chroma
BM25_INDEX_PATH=legacy/travel/runtime/bm25/index.pkl
DANANG_JSON_PATH=legacy/travel/data/knowledge_base.v1.json
METRICS_DIR=var/metrics

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
