# Copy to .env and fill values starting Phase 4. Never commit .env.

# Required from Phase 4
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=
CARTESIA_API_KEY=

# Waiter model: local Ollama is the default (issue #13); Gemini is the fallback.
AGENT_MODE=waiter
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# -1 keeps the model loaded (the Ollama default unloads it after 5 idle minutes).
OLLAMA_KEEP_ALIVE=-1
# Keep fixed while the server runs: changing num_ctx reloads the model.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=256
OLLAMA_TEMPERATURE=0.3
# Leave empty for qwen2.5; set to false for qwen3 to turn off thinking.
OLLAMA_REASONING=
OLLAMA_WARMUP=true
# Speak clean order confirmations from the tool result instead of a second model call.
WAITER_TEMPLATE_REPLIES=false

# Gemini fallback (sliding-window limiter for the free tier)
# GEMINI_RPM=15
# GEMINI_BURST=6

# Optional
CARTESIA_VOICE_ID=
VOICE_PROFILE=friendly_guide
GEMINI_MODEL=gemini-3.5-flash-lite
# Prefer modern plural speech_models chain (mapped in asr_live.py)
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
ASSEMBLYAI_MODE=min_latency

# Paths
CHROMA_PERSIST_DIR=data/chroma
BM25_INDEX_PATH=data/bm25/index.pkl
DANANG_JSON_PATH=data/danang_en/documents.json
METRICS_DIR=reports

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
